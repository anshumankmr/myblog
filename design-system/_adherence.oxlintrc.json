{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/activity/**",
              "components/blog/**",
              "components/core/**",
              "ui_kits/blog/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Serif|IBM Plex Sans|IBM Plex Mono|IBM Plex Sans Devanagari))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Serif, IBM Plex Sans, IBM Plex Mono, IBM Plex Sans Devanagari."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|initials|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, initials, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline|neutral)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bio'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|avatar|handle|handleHref|key|ref|className|style|children)$/]",
        "message": "<Bio> doesn't accept that prop. Declared props: name, role, avatar, handle, handleHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|icon|iconRight|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, icon, iconRight, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalorieDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|eaten|goal|key|ref|className|style|children)$/]",
        "message": "<CalorieDay> doesn't accept that prop. Declared props: date, eaten, goal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|interactive|hoverLift|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, interactive, hoverLift, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|text|date|time|href|key|ref|className|style|children)$/]",
        "message": "<Note> doesn't accept that prop. Declared props: children, text, date, time, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|excerpt|href|onClick|last|key|ref|className|style|children)$/]",
        "message": "<PostListItem> doesn't accept that prop. Declared props: title, date, excerpt, href, onClick, last."
      },
      {
        "selector": "JSXOpeningElement[name.name='Film'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|year|rating|date|rewatch|href|key|ref|className|style|children)$/]",
        "message": "<Film> doesn't accept that prop. Declared props: title, year, rating, date, rewatch, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ride'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|date|distanceKm|movingTimeSec|elevationM|href|key|ref|className|style|children)$/]",
        "message": "<Ride> doesn't accept that prop. Declared props: name, date, distanceKm, movingTimeSec, elevationM, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|onChange|onChrome|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: theme, onChange, onChrome, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ThemeToggle> theme must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
