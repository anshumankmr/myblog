// Header + Footer for the blog UI kit.
// "Pensées" direction: no dark chrome bar. Just a hairline-divided
// strip on the paper page, with the wordmark in italic display
// serif and the nav in tiny tracked-caps Inter Tight.
const { ThemeToggle } = window.AnshumanSBlogDesignSystem_ceace2;

const NAV = [
  { route: 'blogs', label: 'Essays' },
  { route: 'about', label: 'About' },
  { route: 'contact', label: 'Contact' },
];

function NavLink({ label, active, onClick }) {
  const [hover, setHover] = React.useState(false);
  return (
    <a
      onClick={onClick}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      style={{
        cursor: 'pointer',
        fontFamily: 'var(--font-ui)',
        fontWeight: 'var(--fw-medium)',
        fontSize: 'var(--text-eyebrow)',
        letterSpacing: 'var(--tracking-caps)',
        textTransform: 'uppercase',
        color: active ? 'var(--accent)' : (hover ? 'var(--text-heading)' : 'var(--text-meta)'),
        textDecoration: 'none',
        transition: 'color var(--dur-normal) var(--ease-standard)',
        position: 'relative',
        paddingBottom: '4px',
        borderBottom: active ? '1px solid var(--accent)' : '1px solid transparent',
      }}
    >
      {label}
    </a>
  );
}

function IconLink({ icon, label }) {
  const [hover, setHover] = React.useState(false);
  return (
    <a
      href="#"
      onClick={(e) => e.preventDefault()}
      aria-label={label}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      style={{
        color: hover ? 'var(--accent)' : 'var(--text-meta)',
        fontSize: '15px',
        transition: 'color var(--dur-normal) var(--ease-standard)',
      }}
    >
      <i className={icon} aria-hidden="true" />
    </a>
  );
}

function ResumeLink() {
  const [hover, setHover] = React.useState(false);
  return (
    <a
      href="#"
      onClick={(e) => e.preventDefault()}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      style={{
        fontFamily: 'var(--font-ui)',
        fontWeight: 'var(--fw-medium)',
        fontSize: 'var(--text-eyebrow)',
        letterSpacing: 'var(--tracking-caps)',
        textTransform: 'uppercase',
        color: hover ? 'var(--accent-strong)' : 'var(--accent)',
        textDecoration: 'none',
        borderBottom: '1px solid currentColor',
        paddingBottom: '2px',
        transition: 'color var(--dur-normal) var(--ease-standard)',
      }}
    >
      Résumé
    </a>
  );
}

function Wordmark({ onClick }) {
  return (
    <a
      onClick={onClick}
      style={{
        cursor: 'pointer',
        color: 'var(--text-display)',
        fontFamily: 'var(--font-display)',
        fontStyle: 'italic',
        fontWeight: 400,
        fontSize: '28px',
        lineHeight: 1,
        letterSpacing: '-0.01em',
        textDecoration: 'none',
        display: 'inline-flex',
        alignItems: 'baseline',
        gap: '0.35rem',
      }}
    >
      <span>Pensées</span>
      <span style={{
        fontFamily: 'var(--font-ui)', fontStyle: 'normal',
        fontSize: 'var(--text-eyebrow)', letterSpacing: 'var(--tracking-caps)',
        textTransform: 'uppercase', color: 'var(--text-meta)',
        position: 'relative', top: '-3px',
      }}>— A·K</span>
    </a>
  );
}

function Header({ route, navigate, theme, setTheme }) {
  return (
    <header style={{
      background: 'var(--surface-page)',
      borderBottom: '1px solid var(--border-hairline)',
      position: 'sticky', top: 0, zIndex: 50,
      backdropFilter: 'saturate(180%) blur(6px)',
      WebkitBackdropFilter: 'saturate(180%) blur(6px)',
    }}>
      <div style={{
        maxWidth: 'var(--container-wide)', margin: '0 auto',
        padding: '0 var(--space-8)',
      }}>
        <div style={{
          display: 'flex', alignItems: 'center', justifyContent: 'space-between',
          height: '72px',
        }}>
          <Wordmark onClick={() => navigate('home')} />
          <nav style={{ display: 'flex', alignItems: 'center', gap: 'var(--space-8)' }}>
            {NAV.map((n) => (
              <NavLink key={n.route} label={n.label} active={route === n.route || (n.route === 'blogs' && route === 'article')} onClick={() => navigate(n.route)} />
            ))}
            <span style={{ width: '1px', height: '14px', background: 'var(--border-subtle)' }} />
            <IconLink icon="fa-brands fa-linkedin" label="LinkedIn" />
            <IconLink icon="fa-brands fa-github" label="GitHub" />
            <ResumeLink />
            <ThemeToggle theme={theme} onChange={setTheme} />
          </nav>
        </div>
      </div>
    </header>
  );
}

function Footer() {
  return (
    <footer style={{
      background: 'var(--surface-page)',
      borderTop: '1px solid var(--border-hairline)',
      padding: 'var(--space-16) 0 var(--space-12)',
      marginTop: 'var(--space-24)',
    }}>
      <div style={{
        maxWidth: 'var(--container-wide)', margin: '0 auto',
        padding: '0 var(--space-8)',
        display: 'grid',
        gridTemplateColumns: '1fr auto 1fr',
        alignItems: 'center',
        gap: 'var(--space-6)',
      }}>
        <p style={{
          margin: 0, fontFamily: 'var(--font-ui)',
          fontSize: 'var(--text-eyebrow)', letterSpacing: 'var(--tracking-caps)',
          textTransform: 'uppercase', color: 'var(--text-meta)',
        }}>
          © {new Date().getFullYear()} · Anshuman Kumar
        </p>
        <span style={{
          fontFamily: 'var(--font-display)', fontStyle: 'italic',
          color: 'var(--text-muted)', fontSize: '18px',
        }}>
          fin.
        </span>
        <p style={{
          margin: 0, textAlign: 'right',
          fontFamily: 'var(--font-ui)',
          fontSize: 'var(--text-eyebrow)', letterSpacing: 'var(--tracking-caps)',
          textTransform: 'uppercase', color: 'var(--text-meta)',
        }}>
          Bangalore · est. 2024
        </p>
      </div>
    </footer>
  );
}

Object.assign(window, { Header, Footer, Wordmark });
